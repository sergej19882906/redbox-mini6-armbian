		reg = <0x00 0x1800000 0x00 0x4000>;
		interrupts = <0x00 0x53 0x04 0x00 0x54 0x04 0x00 0x55 0x04>;
		interrupt-names = "GPU", "JOB", "MMU";
		clocks = <0xe1 0xe2>;
