	aliases {
		serial0 = "/soc@03000000/uart@05000000";
		serial1 = "/soc@03000000/uart@05000400";
		serial2 = "/soc@03000000/uart@05000800";
		serial3 = "/soc@03000000/uart@05000c00";
		twi0 = "/soc@03000000/twi@0x05002000";
		twi1 = "/soc@03000000/twi@0x05002400";
		twi2 = "/soc@03000000/twi@0x05002800";
		twi3 = "/soc@03000000/twi@0x05002c00";
		spi0 = "/soc@03000000/spi@05010000";
		spi1 = "/soc@03000000/spi@05011000";
		pcie = "/soc@03000000/pcie@0x05400000";
		scr0 = "/soc@03000000/smartcard@0x05005000";
		scr1 = "/soc@03000000/smartcard@0x05005400";
		gmac0 = "/soc@03000000/eth@05020000";
		global_timer0 = "/soc@03000000/timer@03009000";
		mmc0 = "/soc@03000000/sdmmc@04020000";
		mmc2 = "/soc@03000000/sdmmc@04022000";
		nand0 = "/soc@03000000/nand0@04011000";
		disp = "/soc@03000000/disp@01000000";
		lcd0 = "/soc@03000000/lcd0@01c0c000";
		lcd1 = "/soc@03000000/lcd1@01c0c001";
		hdmi = "/soc@03000000/hdmi@06000000";
		pwm = "/soc@03000000/pwm@0300a000";
		pwm0 = "/soc@03000000/pwm0@0300a000";
		pwm1 = "/soc@03000000/pwm1@0300a000";
		tv0 = "/soc@03000000/tv0@01c94000";
		s_pwm = "/soc@03000000/s_pwm@07020c00";
		spwm0 = "/soc@03000000/spwm0@07020c00";
		ac200 = "/soc@03000000/ac200";
		boot_disp = "/soc@03000000/boot_disp";
		charger0 = "/soc@03000000/pmu@0/charger@0";
		regulator0 = "/soc@03000000/pmu@0/regulator@0";
	};

	chosen {
		bootargs = "earlyprintk=sunxi-uart,0x05000000 loglevel=8 initcall_debug=1 console=ttyS0 init=/init";
		linux,initrd-start = <0x00 0x00>;
		linux,initrd-end = <0x00 0x00>;
	};

	firmware {

		android {
			compatible = "android,firmware";
			boot_devices = "soc/sdc0,soc/sdc2,soc";

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/by-name/vendor";
					fsmgr_flags = "wait,recoveryonly";
					mnt_flags = "ro,barrier=1";
					status = "ok";
					type = "ext4";
				};
			};
		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			clocks = <0xd7>;
			clock-latency = <0x1e8480>;
			clock-frequency = <0x4ead9a00>;
			operating-points-v2 = <0xd8 0xd9 0xda 0xdb>;
			cpu-idle-states = <0xdc 0xdd 0xde>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			clocks = <0xd7>;
			clock-frequency = <0x4ead9a00>;
			operating-points-v2 = <0xd8 0xd9 0xda 0xdb>;
			cpu-idle-states = <0xdc 0xdd 0xde>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x02>;
			enable-method = "psci";
			clocks = <0xd7>;
			clock-frequency = <0x4ead9a00>;
			operating-points-v2 = <0xd8 0xd9 0xda 0xdb>;
			cpu-idle-states = <0xdc 0xdd 0xde>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x03>;
			enable-method = "psci";
			clocks = <0xd7>;
			clock-frequency = <0x4ead9a00>;
			operating-points-v2 = <0xd8 0xd9 0xda 0xdb>;
			cpu-idle-states = <0xdc 0xdd 0xde>;
		};

		idle-states {
			entry-method = "arm,psci";

			CPU_SLEEP_0: cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0xfa0>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0x3a98>;
				phandle = <0xdc>;
			};

			CLUSTER_SLEEP_0: cluster-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <0xc350>;
				exit-latency-us = <0x186a0>;
				min-residency-us = <0x3d090>;
				phandle = <0xdd>;
			};

			SYS_SLEEP_0: sys-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010000>;
				entry-latency-us = <0x186a0>;
				exit-latency-us = <0x1e8480>;
				min-residency-us = <0x44aa20>;
				phandle = <0xde>;
			};
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
		psci_version = <0x84000000>;
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
		affinity_info = <0xc4000004>;
		migrate = <0xc4000005>;
		migrate_info_type = <0x84000006>;
		migrate_info_up_cpu = <0xc4000007>;
		system_off = <0x84000008>;
		system_reset = <0x84000009>;
	};

	n_brom {
		compatible = "allwinner,n-brom";
		reg = <0x00 0x00 0x00 0xa000>;
	};

	s_brom {
		compatible = "allwinner,s-brom";
		reg = <0x00 0x00 0x00 0x10000>;
	};

	sram_ctrl {
		device_type = "sram_ctrl";
		compatible = "allwinner,sram_ctrl";
		reg = <0x00 0x3000000 0x00 0x100>;
	};

	sram_a1 {
		compatible = "allwinner,sram_a1";
		reg = <0x00 0x20000 0x00 0x8000>;
	};

	sram_a2 {
		compatible = "allwinner,sram_a2";
		reg = <0x00 0x100000 0x00 0x14000>;
	};

	prcm {
		compatible = "allwinner,prcm";
		reg = <0x00 0x1f01400 0x00 0x400>;
	};

	s_cpuscfg {
		compatible = "allwinner,s_cpuscfg";
		reg = <0x00 0x1f01c00 0x00 0x400>;
	};

	ion {
		compatible = "allwinner,sunxi-ion";

		heap_sys_user@0 {
			compatible = "allwinner,sys_user";
			heap-name = "sys_user";
			heap-id = <0x00>;
			heap-base = <0x00>;
			heap-size = <0x00>;
			heap-type = "ion_system";
		};

		heap_sys_contig@0 {
			compatible = "allwinner,sys_contig";
			heap-name = "sys_contig";
			heap-id = <0x01>;
			heap-base = <0x00>;
			heap-size = <0x00>;
			heap-type = "ion_contig";
		};

		heap_cma@0 {
			compatible = "allwinner,cma";
			heap-name = "cma";
			heap-id = <0x04>;
			heap-base = <0x00>;
			heap-size = <0x00>;
			heap-type = "ion_cma";
		};

		heap_secure@0 {
			compatible = "allwinner,secure";
			heap-name = "secure";
